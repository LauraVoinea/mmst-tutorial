module ClearTermination;

// BROKEN.
// Predict which of WF / SD / CT / BA fails, check, then fix it.
// CLI, from scribble-gt-scala: ./mMST.sh <path>/exercise2/ClearTermination.scr

global protocol ClearTermination(role A, role B, role C) {
    mixed {
        a1() from A to B;
        a2() from A to C;
        a4() from B to A;
        a5() from C to A;
    } or A -> B {
        TOa() from B to A;
        TOc() from B to C;
    }
}
