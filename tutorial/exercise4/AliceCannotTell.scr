module AliceCannotTell;
data <erlang> "integer()" from "rt.jar" as number;
data <erlang> "integer()" from "rt.jar" as result;

// The classical one, and the interesting one: ALL FOUR FLAGS ARE GREEN and the
// protocol is still rejected.
//
// Both branches send Alice the same label, done(). In the sum branch she then
// has to acknowledge; in the diff branch she does not. Nothing in the message
// tells her which branch she is in.
//
// This is knowledge of choice failing for an ordinary DIRECTED choice, and the
// four checks say nothing about it -- it is caught one gate later, by
// projection, as "Couldn't project to Alice".

global protocol AliceCannotTell(role Alice, role Carol, role Srv){
    first(number) from Carol to Srv;
    second(number) from Carol to Srv;
    mixed{
        choice at Carol {
            sum() from Carol to Srv;
            result_sum(result) from Srv to Carol;
            done(result) from Carol to Alice;
            ack() from Alice to Carol;
        } or {
            diff() from Carol to Srv;
            result_diff(result) from Srv to Carol;
            done(result) from Carol to Alice;
        }
    } or Carol -> Srv {
        timeout() from Srv to Carol;
        cancel() from Carol to Alice;
    }
}
