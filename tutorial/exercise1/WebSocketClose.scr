module WebSocketClose;

// RFC 6455 (WebSocket): either endpoint may start the closing handshake, and
// both may send Close at the same time.
// Server observes: it goes along with Client (left) or closes first (right).

global protocol WebSocketClose(role Client, role Server) {
    mixed {                        // left: Client sends, then closes
        frame() from Client to Server;
        ack() from Server to Client;
        close() from Client to Server;
        close_ack() from Server to Client;
    } or Client -> Server {        // right: Server overrules Client
        close() from Server to Client;
        close_ack() from Client to Server;
    }
}
